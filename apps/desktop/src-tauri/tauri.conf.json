{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Tugboat",
  "mainBinaryName": "tugboat",
  "version": "0.3.0",
  "identifier": "app.localtugboat.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tugboat",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://snapthumb.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "UPDATER_PUBKEY_MISSING",
      "endpoints": ["https://github.com/Page011/LocalTugboat/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsi"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
