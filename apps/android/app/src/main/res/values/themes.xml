<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets light/dark and removes the action bar. -->
    <style name="Theme.Tugboat" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.Tugboat.Share" parent="Theme.Tugboat">
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>
